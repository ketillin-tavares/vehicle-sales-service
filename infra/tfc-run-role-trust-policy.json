{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "HcpTerraformDynamicCredentials",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::<AWS_ACCOUNT_ID>:oidc-provider/app.terraform.io"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "app.terraform.io:aud": "aws.workload.identity"
        },
        "StringLike": {
          "app.terraform.io:sub": "organization:<TFC_ORG>:project:<TFC_PROJECT>:workspace:vehicle-sales-infra:run_phase:*"
        }
      }
    }
  ]
}
