# Banco de Dados PostgreSQL
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=vehicle_sales_user
# Obrigatório e sem default no código: a aplicação falha ao iniciar se não for definido.
# Em produção o valor real vem do SSM Parameter Store (SecureString), nunca deste arquivo.
DATABASE_PASSWORD=change-me-local-dev
DATABASE_NAME=vehicle_sales

# vehicle-core-service
CORE_SERVICE_BASE_URL=http://vehicle-core-service:8000
CORE_SERVICE_TIMEOUT_SECONDS=5.0

# Segredos compartilhados entre serviços
# Obrigatórios e sem default no código: a aplicação falha ao iniciar se não forem definidos.
# Em produção os valores reais vêm do SSM Parameter Store (SecureString), nunca deste arquivo.
# O INTERNAL_API_TOKEN precisa ser idêntico ao configurado no vehicle-core-service.
INTERNAL_API_TOKEN=change-me-internal-token
PAYMENT_WEBHOOK_TOKEN=change-me-webhook-token

# Aplicação
SERVICE_NAME=vehicle-sales-service
DEBUG=false
LOG_LEVEL=INFO
